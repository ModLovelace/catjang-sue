{
  "name": "catjang",
  "productName": "Catjang",
  "desktopName": "catjang",
  "version": "0.1.40-experimental.1",
  "description": "A companion cat on your desktop — pomodoro + health-aware pet for coders",
  "author": "jandev-png",
  "license": "CC-BY-NC-4.0",
  "licenseFile": "License.md",
  "homepage": "https://github.com/ModLovelace/catjang-sue",
  "repository": {
    "type": "git",
    "url": "https://github.com/ModLovelace/catjang-sue.git"
  },
  "bugs": {
    "url": "https://github.com/ModLovelace/catjang-sue/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:desktop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\launch-catjang.ps1",
    "smoke": "electron . --catjang-smoke-test",
    "setup:hooks": "node -e \"const i=require('./hooks/install'); i.registerAntigravityHooks(); i.registerClaudeHooks(); i.registerCursorHooks(); console.log('Hooks installed successfully.');\"",
    "notify": "node scripts/notify-catjang.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {},
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "dev.catjang.app",
    "productName": "Catjang",
    "copyright": "Copyright © 2026",
    "publish": null,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "es",
      "es-419",
      "ja",
      "ko"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "editor/**",
      "license/**",
      "hooks/**",
      "agents/**",
      "agents-setup/**",
      "scripts/notify-catjang.js",
      "workspace/assets/sound/**",
      "workspace/assets/img/presets/**",
      "workspace/assets/svg/catjang-logo.svg",
      "workspace/assets/svg/heart.svg",
      "presets/**",
      "svg/cat/**",
      "svg/schnauzer/**",
      "svg/chisi/**",
      "svg/milo/**",
      "svg/musubi/**",
      "svg/peruperro/**",
      "svg/stretch-start.svg",
      "assets/catjang-logo.ico",
      "assets/catjang-logo.png",
      "prototype-license/**",
      "package.json",
      "!node_modules/uiohook-napi/src/**",
      "!node_modules/uiohook-napi/libuiohook/**",
      "!node_modules/uiohook-napi/**/*.map"
    ],
    "win": {
      "icon": "assets/catjang-logo.ico",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "ffmpeg.exe.LICENSE",
            "ffmpeg.exe.README",
            "LICENSE"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/catjang-logo.png",
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "ffmpeg.LICENSE",
            "ffmpeg.README",
            "LICENSE"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/catjang-logo.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "ffmpeg.LICENSE",
            "ffmpeg.README",
            "LICENSE"
          ]
        }
      ],
      "syncDesktopName": true
    }
  }
}
