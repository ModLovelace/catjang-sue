{
  "name": "catjang",
  "productName": "Catjang",
  "version": "0.1.38",
  "description": "A companion cat on your desktop — pomodoro + health-aware pet for coders",
  "author": "jandev-png",
  "license": "CC-BY-NC-4.0",
  "licenseFile": "License.md",
  "homepage": "https://github.com/ModLovelace/catjang-sue",
  "repository": {
    "type": "git",
    "url": "https://github.com/ModLovelace/catjang-sue.git"
  },
  "bugs": {
    "url": "https://github.com/ModLovelace/catjang-sue/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --catjang-smoke-test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.catjang.app",
    "productName": "Catjang",
    "copyright": "Copyright © 2026",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "editor/**",
      "license/**",
      "hooks/**",
      "agents/**",
      "workspace/**",
      "presets/**",
      "svg/**",
      "assets/**",
      "prototype-license/**",
      "package.json"
    ],
    "extraResources": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "assets/catjang-logo.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
